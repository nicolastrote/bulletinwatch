{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[bulletinwatch] $(date '+%H:%M:%S') PRE-WRITE: $CLAUDE_TOOL_INPUT_FILE_PATH\" >> /tmp/bulletinwatch-audit.log"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/linuxmoi/Documents/bulletinwatch/.claude/hooks/check-syntax.sh",
            "statusMessage": "Vérification syntaxe...",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[bulletinwatch] $(date '+%H:%M:%S') Session terminée\" >> /tmp/bulletinwatch-audit.log"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(playwright:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(git:*)"
    ]
  }
}
